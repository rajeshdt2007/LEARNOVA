# LEARNOVA Backend Environment Configuration
PROJECT_NAME="LEARNOVA API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# CORS configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Supabase Credentials (obtain from your Supabase project dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
